# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Google SMTP (App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Nahda Publications <your-gmail@gmail.com>"

# Public site URL (required in production / Vercel)
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# Optional Cloudflare Turnstile (human check on login/register ONLY).
# CURRENTLY PAUSED in code (TURNSTILE_ACTIVE = false). Uncomment keys + flip
# the kill switch in src/lib/turnstile.ts and turnstile-public.ts to re-enable.
# Do NOT enable site-wide “Are you a robot?” / Bot Fight Mode challenges —
# those block Google Scholar and research crawlers from indexing papers.
# Create keys at: https://dash.cloudflare.com → Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAA..."
#
# If the domain is proxied through Cloudflare, also:
# - Security → Bots: allow Verified bots / known good bots
# - Prefer a WAF Skip rule for cf.client.bot on /articles* /api/articles* /nid* /doi*
# - Avoid challenging every visitor with Managed Challenge on public research URLs

# APC is collected via PayPal (Nahda Publications account).
# PayPal email: Asareowusuclems2024@gmail.com
# Account name: Asare Clement (Nahda Publications)
# Authors receive a Nahda USD receipt after an editor confirms payment.
# Fallback APC when a journal has no dollar amount (USD cents). Default $1,200.
DEFAULT_APC_CENTS="120000"

# Legacy Paystack keys are no longer used for APC checkout.
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

