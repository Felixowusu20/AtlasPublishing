# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Auth
AUTH_SECRET="replace-with-a-long-random-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Google SMTP (App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Nahda Publications <your-gmail@gmail.com>"

# Public site URL (required in production / Vercel)
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# Paystack (test or live keys — no spaces / comments on the same line)
# Customer-facing prices, emails, and receipts are always USD.
# Paystack transactions are initialized in GHS (Ghana settlement). Do not spoof
# Paystack’s hosted checkout. Set the USD→GHS rate on the server only.
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_CURRENCY="GHS"
USD_TO_GHS_RATE="15.5"
# Alias still supported:
# PAYSTACK_GHS_PER_USD="15.5"
# Optional: Paystack's own receipt goes here (not to the author). Defaults to SMTP_FROM / SMTP_USER.
# Authors receive only the Nahda branded USD receipt from this app.
# Also turn OFF "Email receipts to customers" in Paystack → Settings → Preferences.
# PAYSTACK_RECEIPT_INBOX="billing@your-domain.com"
# Fallback APC when a journal has no dollar amount (USD cents). Default $1,200.
DEFAULT_APC_CENTS="120000"

# Nahda editorial AI (admin /ai workspace). Add one provider + model name.
# The UI and /api/admin/ai/* routes are ready; live SDK wiring comes next.
# NAHDA_AI_PROVIDER="openai"   # openai | anthropic | google | azure
# NAHDA_AI_MODEL="gpt-4.1-mini"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4.1-mini"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"
# GOOGLE_AI_API_KEY="..."
# GOOGLE_AI_MODEL="gemini-2.0-flash"
# AZURE_OPENAI_API_KEY="..."
# AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT="your-deployment-name"
