# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Auth
AUTH_SECRET=""


# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Google SMTP (App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Nahda Publications <your-gmail@gmail.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe test/live keys (no spaces around =)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Fallback APC when a journal has no dollar amount (cents). Default $1,200.
DEFAULT_APC_CENTS="120000"
